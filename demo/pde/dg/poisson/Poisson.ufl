# First added:  2006-12-05
# Last changed: 2007-05-29
#
# The bilinear.ufl a(v, u) and linear.ufl L(v) for
# Poisson's equation in a discontinuous Galerkin (DG)
#.uflulation.
#
# Compile this.ufl with FFC: ffc -l dolfin Poisson.ufl

# Elements
element = FiniteElement("Discontinuous Lagrange", "triangle", 1)

# Test and trial functions
v = TestFunction(element)
u = TrialFunction(element)
f =Coefficient(element)

# Normal component, mesh size and right-hand side
n = FacetNormal("triangle")
h = Circumradius("triangle")

# Parameters
alpha = 4.0
gamma = 8.0

# Bilinear.ufl
a = inner(grad(v), grad(u))*dx \
   - inner(avg(grad(v)), jump(u, n))*dS \
   - inner(jump(v, n), avg(grad(u)))*dS \
   + alpha/h('+')*dot(jump(v, n), jump(u, n))*dS \
   - inner(grad(v), (u* n))*ds \
   - inner((v* n), grad(u))*ds \
   + gamma/h*v*u*ds

# Linear.ufl
L = v*f*dx

