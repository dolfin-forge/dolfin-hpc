#ifndef __DOLFIN_TESTS_HEADER_H_
#define __DOLFIN_TESTS_HEADER_H_

#include <dolfin/common/system.h>
#include <dolfin/common/Check.h>
#include <dolfin/common/Test.h>
#include <dolfin/common/timing.h>

namespace dolfin
{

static const char SOURCE_DIRECTORY[] = "#abs_top_srcdir#";
static const char MESHES_DIRECTORY[] = "#abs_top_srcdir#/data/meshes";
static const char STESTS_DIRECTORY[] = "#abs_top_srcdir#/tests";

std::string mesh_file(const char * s)
{
  return path(std::string(MESHES_DIRECTORY), std::string(s));
}

std::string testdir(const char * s)
{
  return path(std::string(STESTS_DIRECTORY), std::string(s));
}

std::string testdata(const char * s, const char * c)
{
  return path(std::string(STESTS_DIRECTORY), path(std::string(s), std::string(c)), "data");
}

std::string testresu(const char * s, const char * c)
{
  return path(std::string(STESTS_DIRECTORY), path(std::string(s), std::string(c)), "resu");
}

} /* namespace dolfin */

#endif /* __DOLFIN_TESTS_HEADER_H_ */
