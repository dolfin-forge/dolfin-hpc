#
# This.ufl defines the functional for computing the
# drag on a body.
#
# Compile this.ufl with FFC: ffc -l dolfin Drag.ufl.

element = FiniteElement("Lagrange", "triangle", 1)

p =Coefficient(element)
n = FacetNormal("triangle")
M = -p*n[0]*ds
