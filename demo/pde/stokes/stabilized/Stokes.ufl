# First added:  2005
# Last changed: 2007-04-30
#
# The bilinear.ufl a(v, u) and Linear.ufl L(v) for the Stokes
# equations using a mixed.uflulation (equal-order stabilized).
#
# Compile this.ufl with FFC: ffc -l dolfin Stokes.ufl

vector = VectorElement("Lagrange", "triangle", 1)
scalar = FiniteElement("Lagrange", "triangle", 1)
system = vector * scalar

(v, q) = TestFunctions(system)
(u, p) = TrialFunctions(system)

f =Coefficient(vector)
h =Coefficient(scalar)

beta  = 0.2
delta = beta*h*h

a = (inner(grad(v), grad(u)) - div(v)*p + q*div(u) + delta*dot(grad(q), grad(p)))*dx
L = inner(v + (delta* grad(q)), f)*dx
