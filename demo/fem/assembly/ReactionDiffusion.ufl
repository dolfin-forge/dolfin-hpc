# First added:  2008-02-04
# Last changed: 2008-02-04
#
# The bilinear.ufl a(v, u) and linear.ufl L(v) for
# the reaction-diffusion equation -div grad u + u = f.
#
# Compile this.ufl with FFC: ffc -l dolfin ReactionDiffusion.ufl

element = FiniteElement("Lagrange", "tetrahedron", 1)

v = TestFunction(element)
u = TrialFunction(element)
f = Coefficient(element)

a = inner(grad(v), grad(u))*dx + v*u*dx
L = v*f*dx
